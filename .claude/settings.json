{
  "env": {
    "npm_config_cache": "C:/Users/tomer/Desktop/new discord/.cache/npm",
    "NUGET_PACKAGES": "C:/Users/tomer/Desktop/new discord/.cache/nuget/packages",
    "NUGET_HTTP_CACHE_PATH": "C:/Users/tomer/Desktop/new discord/.cache/nuget/http",
    "NUGET_PLUGINS_CACHE_PATH": "C:/Users/tomer/Desktop/new discord/.cache/nuget/plugins",
    "DOTNET_CLI_HOME": "C:/Users/tomer/Desktop/new discord/.cache/dotnet",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "PIP_CACHE_DIR": "C:/Users/tomer/Desktop/new discord/.cache/pip",
    "NG_CLI_ANALYTICS": "false",
    "PLAYWRIGHT_BROWSERS_PATH": "C:/Users/tomer/Desktop/new discord/.cache/ms-playwright"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|Glob|Grep|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/path-guard.js\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.js\"" }
        ]
      }
    ]
  }
}
