# Authorization watchdog (chmod 600). A dedicated LiveKit key pair, listed in livekit-keys.yaml next to the API's,
# so it can be rotated on its own. It is only used to list and delete rooms over loopback.
LIVEKIT_API_KEY=watchdog
LIVEKIT_API_SECRET=CHANGE_ME_same_as_the_watchdog_entry_in_livekit-keys.yaml
# Optional tuning (seconds): TRIP_AFTER=60 RECOVER_AFTER=30 INTERVAL=5
