# Backup job (chmod 600). AGE_RECIPIENTS are PUBLIC keys; keep the identity (private key) off this host.
AGE_RECIPIENTS=age1CHANGE_ME
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=hangar
PGDATABASE=hangar
# rclone remote configured in /srv/hangar/config/rclone.conf (another provider/account = another failure domain).
RCLONE_REMOTE=offsite:hangar-backups
LOCAL_KEEP=2
DAILY_DAYS=7
WEEKLY_DAYS=28
HANGAR_VERSION=2026.10.0
