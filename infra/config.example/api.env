# API secrets/config (chmod 600, root-owned). Copy to /srv/hangar/config/api.env.
# Listens on 127.0.0.1:8080 (image default); Caddy on the same host is the only trusted proxy.
ConnectionStrings__Hangar=Host=127.0.0.1;Port=5432;Database=hangar;Username=hangar;Password=CHANGE_ME_same_as_postgres_password;GSS Encryption Mode=Disable
Hangar__PublicBaseUrl=https://app.example.com
Hangar__AllowedOrigins__0=https://app.example.com
Hangar__TrustedProxies__0=127.0.0.1
Hangar__LiveKit__ApiUrl=http://127.0.0.1:7880
Hangar__LiveKit__PublicUrl=wss://rtc.example.com
# Must match a key in livekit-keys.yaml (and webhook.api_key in livekit.yaml).
Hangar__LiveKit__ApiKey=hangar
Hangar__LiveKit__ApiSecret=CHANGE_ME_openssl_rand_hex_32
Hangar__Soundboard__PublisherUrl=http://127.0.0.1:8090
Hangar__Soundboard__WorkerKey=CHANGE_ME_openssl_rand_hex_32_shared_with_publisher.env
