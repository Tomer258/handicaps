# Ops monitor (chmod 600: the webhook URL is a secret). Without a webhook, alerts only go to `dc logs ops-monitor`.
# Discord: channel settings → Integrations → Webhooks → copy URL. ntfy.sh topic URLs work too (plain text).
ALERT_WEBHOOK_URL=
# Your plan's monthly traffic allowance in GiB (0 = do not track). Alerts at 70 %.
TRAFFIC_MONTHLY_GB=0
# Optional thresholds: DISK_ALERT_PERCENT=80 CPU_ALERT_PERCENT=75 CPU_WINDOW_MIN=15 MEM_ALERT_PERCENT=90
#   CERT_ALERT_DAYS=14 BACKUP_MAX_AGE_HOURS=36 API_ALERT_MIN=3 RECONCILE_ALERT_MIN=5 REMIND_HOURS=6 INTERVAL=60
#   TRAFFIC_IFACE=eth0 (default: the interface of the default route)
