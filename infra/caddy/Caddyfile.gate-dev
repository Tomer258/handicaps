# Local verification of the LiveKit signaling gate (no TLS, no layer4). Same forward_auth route as production.
#   docker run --rm -d --name hangar-gate -p 127.0.0.1:7890:7890 --add-host host.docker.internal:host-gateway \
#     -v "$PWD/infra/caddy/Caddyfile.gate-dev:/etc/caddy/Caddyfile:ro" -v "$PWD/.tmp/watchdog:/run/hangar-watchdog:ro" hangar-edge:dev
# then run the API with Hangar__LiveKit__PublicUrl=ws://localhost:7890 and `node scripts/gate-check.mjs`.
{
	admin off
	auto_https off
}

:7890 {
	@signal path /rtc /rtc/*
	@watchdog_closed file {
		root /run/hangar-watchdog
		try_files /closed
	}
	handle @signal {
		route {
			respond @watchdog_closed "Voice is temporarily unavailable" 503
			forward_auth host.docker.internal:5080 {
				uri /internal/livekit/admission
			}
			reverse_proxy host.docker.internal:7880
		}
	}
	handle {
		respond 404
	}
}
